    ],
    "admin-authorization": [
      "^src/features/auth/AdminRoute\\.tsx$",
      "^src/server/api/_lib/(?:authorization|capabilities|program-access-policy)\\.ts$",
      "^src/server/api/admin/app\\.ts$"
    ]

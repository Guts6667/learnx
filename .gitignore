# No trailing slash: a bare `node_modules/` matches a directory only, and a
# symlink named node_modules is a file. One was committed on 30 August 2026
# from an agent worktree that linked to another checkout, and CI failed with
# ENOTDIR on mkdir — an infrastructure-looking error with a repository cause.
node_modules
dist/
coverage/
playwright-report/
playwright-report-integration/
playwright-report-production/
test-results/
test-results-integration/
test-results-production/
generated/
.env
.env.*
!.env.example
.neon
*.local
.DS_Store
.vercel
benchmarks/ai-correction/results/
.mcp.json
.claude/settings.local.json

# Console output redirected to a file. Five such logs reached dev in 981b661e,
# carrying the absolute paths of the worktree that produced them.
*.log

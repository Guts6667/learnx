model AiCorrection {
  id                          String                          @id @default(uuid()) @db.Uuid
  userId                      String                          @map("user_id") @db.Uuid
  exerciseSubmissionId        String?                         @map("exercise_submission_id") @db.Uuid
  stageAssessmentSubmissionId String?                         @map("stage_assessment_submission_id") @db.Uuid
  method                      AiCorrectionMethod              @default(AI)
  status                      AiCorrectionStatus              @default(RESERVED)
  decision                    AiCorrectionDecision?
  idempotencyKey              String                          @map("idempotency_key")
  requestFingerprint          String                          @map("request_fingerprint") @db.Char(64)
  /// Nullable depuis V4.5-168 : `NULL` signifie **détachée**, jamais « reçue
  /// vide ». Toute correction en a une à l'écriture, donc l'absence ne peut
  /// venir que du détachement à 180 jours.
  submissionSnapshot          Json?                           @map("submission_snapshot_json")
  contractSnapshot            Json                            @map("contract_snapshot_json")
  /// Nullable pour la même raison : il contient la production.
  promptSnapshot              Json?                           @map("prompt_snapshot_json")
  promptVersion               String                          @map("prompt_version")
  modelRole                   String                          @map("model_role")
  provider                    String?
  modelId                     String?                         @map("model_id")
  structuredResult            Json?                           @map("structured_result_json")
  score                       Float?
  confidence                  Float?
  pipelineKind                AiCorrectionPipelineKind        @default(SINGLE_MODEL) @map("pipeline_kind")
  pipelineVersionId           String?                         @map("pipeline_version_id") @db.Uuid
  pipelineIdentitySnapshot    Json?                           @map("pipeline_identity_snapshot_json")
  triggerDecision             Json?                           @map("trigger_decision_json")
  consolidation               Json?                           @map("consolidation_json")
  indicativeScore             Float?                          @map("indicative_score")
  scoreRange                  Json?                           @map("score_range_json")
  pricingQuoteId              String?                         @unique @map("pricing_quote_id") @db.Uuid
  creditReservationId         String?                         @unique @map("credit_reservation_id") @db.Uuid
  reconsiderationOfId         String?                         @unique @map("reconsideration_of_id") @db.Uuid
  reconsiderationArgument     String?                         @map("reconsideration_argument") @db.VarChar(500)
  orchestrationFingerprint    String?                         @map("orchestration_fingerprint") @db.Char(64)
  startedAt                   DateTime?                       @map("started_at")
  completedAt                 DateTime?                       @map("completed_at")
  /// Quand la correction a cessé d'être rattachable à son auteur (V4.5-168).
  /// Renseigné plutôt que déduit de l'absence de production : le registre RGPD
  /// doit pouvoir attester que la purge a tourné, pas seulement constater un
  /// vide.
  detachedAt                  DateTime?                       @map("detached_at")
  createdAt                   DateTime                        @default(now()) @map("created_at")
  updatedAt                   DateTime                        @updatedAt @map("updated_at")
  user                        User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseSubmission          ExerciseSubmission?             @relation(fields: [exerciseSubmissionId, userId], references: [id, userId], onDelete: Restrict)
  stageAssessmentSubmission   StageAssessmentSubmission?      @relation(fields: [stageAssessmentSubmissionId, userId], references: [id, userId], onDelete: Restrict)
  attempts                    AiCorrectionAttempt[]
  pipelineVersion             AiCorrectionPipelineVersion?    @relation(fields: [pipelineVersionId], references: [id], onDelete: Restrict)
  roleExecutions              AiCorrectionRoleExecution[]
  pricingQuote                AiPricingQuote?                 @relation(fields: [pricingQuoteId, userId], references: [id, userId], onDelete: Restrict)
  creditReservation           CreditReservation?              @relation(fields: [creditReservationId, userId], references: [id, userId], onDelete: Restrict)
  financialOperation          AiCorrectionFinancialOperation?
  reconsiderationOf           AiCorrection?                   @relation("AiCorrectionReconsideration", fields: [reconsiderationOfId], references: [id], onDelete: Restrict)
  reconsideration             AiCorrection?                   @relation("AiCorrectionReconsideration")
  reconsiderationQuotes       AiPricingQuote[]                @relation("AiPricingQuoteReconsideration")
  criterionFeedback           AiCorrectionCriterionFeedback[]

  // Redundant against the primary key, and deliberately so: it is what lets
  // the feedback table carry a compound foreign key on (correction, user), so
  // a row pointing at someone else's correction is refused by the database
  // rather than only by the route that happens to check.
  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@unique([pricingQuoteId, userId])
  @@unique([creditReservationId, userId])
  @@index([exerciseSubmissionId, createdAt])
  @@index([stageAssessmentSubmissionId, createdAt])
  @@index([status, updatedAt])
  @@map("ai_corrections")
}

model AiCorrectionAttempt {
  id                     String                     @id @default(uuid()) @db.Uuid
  correctionId           String                     @map("correction_id") @db.Uuid
  sequence               Int
  status                 AiCorrectionAttemptStatus  @default(PROCESSING)
  provider               String?
  modelId                String?                    @map("model_id")
  modelRole              String                     @map("model_role")
  generationId           String?                    @map("generation_id")
  structuredResult       Json?                      @map("structured_result_json")
  errorCode              String?                    @map("error_code")
  retryable              Boolean?
  promptTokens           Int?                       @map("prompt_tokens")
  completionTokens       Int?                       @map("completion_tokens")
  totalTokens            Int?                       @map("total_tokens")
  costUsd                Decimal?                   @map("cost_usd") @db.Decimal(18, 8)
  costSource             AiCorrectionCostSource?    @map("cost_source")
  latencyMs              Int?                       @map("latency_ms")
  completedAt            DateTime?                  @map("completed_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  roleExecutionId        String?                    @map("role_execution_id") @db.Uuid
  attemptNumber          Int?                       @map("attempt_number")
  rawOutput              Json?                      @map("raw_output_json")
  validationCode         String?                    @map("validation_code")
  providerRequestId      String?                    @map("provider_request_id")
  modelSnapshot          String?                    @map("model_snapshot")
  reasoningTokens        Int?                       @map("reasoning_tokens")
  requestManifest        Json?                      @map("request_manifest_json")
  requestBodySha256      String?                    @map("request_body_sha256") @db.Char(64)
  wireSchemaSha256       String?                    @map("wire_schema_sha256") @db.Char(64)
  routerMetadata         Json?                      @map("router_metadata_json")
  providerIdempotencyKey String?                    @unique @map("provider_idempotency_key")
  dispatchStatus         AiProviderDispatchStatus?  @map("dispatch_status")
  costConfirmedAt        DateTime?                  @map("cost_confirmed_at")
  correction             AiCorrection               @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  roleExecution          AiCorrectionRoleExecution? @relation(fields: [roleExecutionId], references: [id], onDelete: Restrict)

  @@unique([correctionId, sequence])
  @@unique([provider, generationId])
  @@unique([roleExecutionId, attemptNumber])
  @@index([status, createdAt])
  @@map("ai_correction_attempts")
}

model AiCorrectionPipelineVersion {
  id                  String                     @id @default(uuid()) @db.Uuid
  pipelineKey         String                     @map("pipeline_key")
  version             String
  status              AiCorrectionPipelineStatus @default(DRAFT)
  identityFingerprint String                     @map("identity_fingerprint") @db.Char(64)
  protocolVersion     String                     @map("protocol_version")
  primaryConfig       Json                       @map("primary_config_json")
  verifierConfig      Json                       @map("verifier_config_json")
  triggerConfig       Json                       @map("trigger_config_json")
  consolidatorConfig  Json                       @map("consolidator_config_json")
  effectiveAt         DateTime?                  @map("effective_at")
  retiredAt           DateTime?                  @map("retired_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  corrections         AiCorrection[]
  pricingCatalogs     AiPricingCatalogVersion[]
  pricingQuotes       AiPricingQuote[]

  @@unique([pipelineKey, version])
  @@unique([id, identityFingerprint])
  @@index([status, effectiveAt])
  @@map("ai_correction_pipeline_versions")
}

model AiCorrectionRoleExecution {
  id                 String                          @id @default(uuid()) @db.Uuid
  correctionId       String                          @map("correction_id") @db.Uuid
  role               AiCorrectionRole
  ordinal            Int                             @default(1)
  status             AiCorrectionRoleExecutionStatus @default(PENDING)
  assignmentSnapshot Json                            @map("assignment_snapshot_json")
  promptSnapshot     Json                            @map("prompt_snapshot_json")
  profileSnapshot    Json                            @map("profile_snapshot_json")
  canonicalResult    Json?                           @map("canonical_result_json")
  rejectionCode      String?                         @map("rejection_code")
  leaseToken         String?                         @unique @map("lease_token")
  leaseOwner         String?                         @map("lease_owner")
  leaseExpiresAt     DateTime?                       @map("lease_expires_at")
  startedAt          DateTime?                       @map("started_at")
  completedAt        DateTime?                       @map("completed_at")
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")
  correction         AiCorrection                    @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  attempts           AiCorrectionAttempt[]

  @@unique([correctionId, role, ordinal])
  @@index([status, leaseExpiresAt])
  @@map("ai_correction_role_executions")
}

model AiCorrectionFinancialOperation {
  id                            String                      @id @default(uuid()) @db.Uuid
  correctionId                  String                      @unique @map("correction_id") @db.Uuid
  reservationId                 String                      @unique @map("reservation_id") @db.Uuid
  userId                        String                      @map("user_id") @db.Uuid
  status                        AiCorrectionFinancialStatus @default(PENDING)
  acceptedCeilingCredits        BigInt                      @map("accepted_ceiling_credits")
  settledCredits                BigInt?                     @map("settled_credits")
  releasedCredits               BigInt?                     @map("released_credits")
  providerCostUsd               Decimal?                    @map("provider_cost_usd") @db.Decimal(18, 8)
  billableProviderCostUsd       Decimal?                    @map("billable_provider_cost_usd") @db.Decimal(18, 8)
  absorbedProviderCostUsd       Decimal?                    @map("absorbed_provider_cost_usd") @db.Decimal(18, 8)
  absorbedCeilingOverrunCredits BigInt?                     @map("absorbed_ceiling_overrun_credits")
  allocationSnapshot            Json                        @map("allocation_snapshot_json")
  settlementSnapshot            Json?                       @map("settlement_snapshot_json")
  reconciliationCode            String?                     @map("reconciliation_code")
  alertRequired                 Boolean                     @default(false) @map("alert_required")
  completedAt                   DateTime?                   @map("completed_at")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @updatedAt @map("updated_at")
  correction                    AiCorrection                @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  reservation                   CreditReservation           @relation(fields: [reservationId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([reservationId, userId])
  @@index([status, updatedAt])
  @@index([userId, createdAt])
  @@map("ai_correction_financial_operations")
}

/// Retour de l'apprenant sur un critère d'une correction (V4.5-112).
///
/// Une ligne par (correction, apprenant, critère) : renvoyer un verdict
/// remplace le précédent, il n'en empile pas un second. L'apprenant peut se
/// raviser, et le compte de « ce critère est faux » reste un compte de
/// personnes, pas de clics.
model AiCorrectionCriterionFeedback {
  id           String                      @id @default(uuid()) @db.Uuid
  correctionId String                      @map("correction_id") @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  criterionKey String                      @map("criterion_key")
  verdict      AiCorrectionFeedbackVerdict
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  correction   AiCorrection                @relation(fields: [correctionId, userId], references: [id, userId], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([correctionId, userId, criterionKey])
  @@index([correctionId])
  @@map("ai_correction_criterion_feedback")
}

/// Journal du coupe-circuit de correction (V4.5-140).
///
/// En ajout seul, et non un état modifiable : l'état courant se déduit du
/// dernier événement. Refermer le circuit exige donc d'écrire une ligne, ce qui
/// rend la réouverture auditée par construction — on ne peut pas effacer un
/// déclenchement en remettant un booléen à faux.
model AiCorrectionBreakerEvent {
  id         String                     @id @default(uuid()) @db.Uuid
  action     AiCorrectionBreakerAction
  reason     AiCorrectionBreakerReason?
  rate       Float?
  threshold  Float?
  windowSize Int?                       @map("window_size")
  /// L'administrateur qui rouvre. Nul quand le système déclenche.
  actorId    String?                    @map("actor_id") @db.Uuid
  note       String?                    @db.VarChar(500)
  /// Quand l'alerte propriétaire est partie. Nul tant qu'aucune tentative.
  alertedAt  DateTime?                  @map("alerted_at")
  /// Pourquoi elle n'est pas partie. Un propriétaire jamais prévenu doit au
  /// moins être découvrable : une alerte silencieusement perdue ramène le
  /// défaut que ce ticket existe pour supprimer.
  alertError String?                    @map("alert_error") @db.VarChar(500)
  createdAt  DateTime                   @default(now()) @map("created_at")
  actor      User?                      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("ai_correction_breaker_events")
}

/// Ce qui reste d'une correction après le détachement à 180 jours (V4.5-168,
/// décision `owner-rgpd-2026-08-29` §2).
///
/// La ligne n'a **aucun lien** vers la correction ni vers le compte : ni
/// `correction_id`, ni `user_id`, ni horodatage plus fin que le jour. Le seul
/// identifiant est un pseudonyme tiré au hasard, dont aucune correspondance
/// n'est conservée nulle part — c'est ce qui rend le détachement
/// irréversible, et non une promesse tenue par du code qui pourrait être
/// réécrit.
///
/// Pseudonymisation, pas anonymisation : les textes conservés ici sont ceux de
/// l'apprenant, et un texte libre peut nommer son auteur. L'audit le dit
/// (§7 décision 3) et la politique de confidentialité doit le dire aussi.
///
/// Écrite **uniquement** si le compte portait le consentement de réutilisation
/// au moment du détachement. Sans consentement, les mêmes textes sont
/// simplement supprimés : l'apprenant est détaché dans les deux cas.
model AiCorrectionResearchSample {
  /// Tiré au hasard, sans rapport avec l'identifiant de la correction.
  pseudonym          String   @id @db.Uuid
  /// Le jour, pas l'instant : une seconde précise rapprochée d'un journal
  /// suffirait à retrouver qui écrivait à ce moment-là.
  detachedOn         DateTime @map("detached_on") @db.Date
  activityType       String   @map("activity_type")
  promptVersion      String   @map("prompt_version")
  modelId            String?  @map("model_id")
  /// La production de l'apprenant, déplacée depuis `ai_corrections`.
  submissionSnapshot Json     @map("submission_snapshot_json")
  /// Le prompt tel qu'envoyé, qui contient cette production.
  promptSnapshot     Json     @map("prompt_snapshot_json")
  /// Les extraits cités par la correction, retirés de son résultat structuré.
  evidenceQuotes     Json     @map("evidence_quotes_json")
  /// Les sorties brutes des tentatives, déplacées depuis `ai_correction_attempts`.
  rawOutputs         Json     @map("raw_outputs_json")

  @@index([detachedOn])
  @@map("ai_correction_research_samples")
}

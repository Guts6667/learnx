enum ExerciseSubmissionStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")

  @@map("exercise_submission_status")
}

enum AiCorrectionMethod {
  DETERMINISTIC @map("deterministic")
  AI            @map("ai")

  @@map("ai_correction_method")
}

enum AiCorrectionStatus {
  RESERVED                @map("reserved")
  PROCESSING              @map("processing")
  PROCESSING_PRIMARY      @map("processing_primary")
  VERIFYING               @map("verifying")
  COMPLETED               @map("completed")
  PROVISIONAL             @map("provisional")
  UNCERTAIN               @map("uncertain")
  AI_REVIEW_REQUIRED      @map("ai_review_required")
  RETRY_PENDING           @map("retry_pending")
  SETTLEMENT_PENDING      @map("settlement_pending")
  RELEASE_PENDING         @map("release_pending")
  RECONCILIATION_REQUIRED @map("reconciliation_required")
  UNUSABLE_RELEASED       @map("unusable_released")

  @@map("ai_correction_role_execution_status")
}

enum AiPricingWorkflowKind {
  SINGLE_MODEL @map("single_model")
  COMPOSITE    @map("composite")

  @@map("ai_pricing_workflow_kind")
}

enum AiCorrectionDecision {
  PASSED          @map("passed")
  NOT_PASSED      @map("not_passed")
  REVIEW_REQUIRED @map("review_required")

  @@map("ai_correction_decision")
}

enum AiCorrectionAttemptStatus {
  PROCESSING @map("processing")
  SUCCEEDED  @map("succeeded")
  FAILED     @map("failed")

  @@map("ai_correction_attempt_status")
}

enum AiCorrectionCostSource {
  ACTUAL                 @map("actual")
  CONSERVATIVE_WRITE_OFF @map("conservative_write_off")

  @@map("ai_correction_cost_source")
}

enum CreditCurrency {
  LEARNX_CREDIT @map("learnx_credit")

  @@map("credit_currency")
}

enum CreditProvenance {
  FREE_ALLOCATION @map("free_allocation")
  PURCHASED       @map("purchased")

  @@map("credit_provenance")
}

enum CreditLedgerEntryType {
  GRANT               @map("grant")
  RESERVATION_HOLD    @map("reservation_hold")
  RESERVATION_RELEASE @map("reservation_release")
  SETTLEMENT          @map("settlement")
  EXPIRATION          @map("expiration")
  ADMIN_ADJUSTMENT    @map("admin_adjustment")

  @@map("credit_ledger_entry_type")
}

enum CreditReservationStatus {
  RESERVED         @map("reserved")
  SETTLED          @map("settled")
  RELEASED         @map("released")
  EXPIRED_RELEASED @map("expired_released")

  @@map("credit_reservation_status")
}

enum CreditPolicyStatus {
  DRAFT    @map("draft")
  INACTIVE @map("inactive")
  ACTIVE   @map("active")
  RETIRED  @map("retired")

  @@map("credit_policy_status")
}

enum CreditIncreaseRequestStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
  CANCELLED @map("cancelled")

  @@map("credit_increase_request_status")
}

enum AiPricingCatalogStatus {
  DRAFT    @map("draft")
  INACTIVE @map("inactive")
  ACTIVE   @map("active")
  RETIRED  @map("retired")

  @@map("ai_pricing_catalog_status")
}

enum AiPricingAction {
  STANDARD        @map("standard")
  DETAILED        @map("detailed")
  REINFORCED      @map("reinforced")
  RECONSIDERATION @map("reconsideration")
  FUTURE_RESERVED @map("future_reserved")

  @@map("ai_pricing_action")
}

enum AiPricingInputSizeClass {
  SHORT  @map("short")
  MEDIUM @map("medium")
  LONG   @map("long")

  @@map("ai_pricing_input_size_class")
}

enum AiPricingTargetKind {
  EXERCISE_SUBMISSION         @map("exercise_submission")
  STAGE_ASSESSMENT_SUBMISSION @map("stage_assessment_submission")

  @@map("ai_pricing_target_kind")
}

enum ReviewSourceType {
  CONCEPT_ASSESSMENT @map("concept_assessment")

  @@map("review_source_type")
}

enum ReviewStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")

  @@map("review_status")
}

model User {
  id                              String                        @id @default(uuid()) @db.Uuid
  email                           String                        @unique
  passwordHash                    String                        @map("password_hash")
  displayName                     String                        @map("display_name")
  role                            Role                          @default(USER)
  accountStatus                   AccountStatus                 @default(ACTIVE) @map("account_status")
  locale                          String                        @default("fr") @db.VarChar(2)
  suspendedAt                     DateTime?                     @map("suspended_at")
  createdAt                       DateTime                      @default(now()) @map("created_at")
  updatedAt                       DateTime                      @updatedAt @map("updated_at")
  sessions                        Session[]
  programs                        Program[]
  programProgresses               ProgramProgress[]
  stageProgresses                 StageProgress[]
  lessonProgresses                LessonProgress[]
  taskCompletions                 TaskCompletion[]
  resourceProgresses              ResourceProgress[]
  conceptProgresses               ConceptProgress[]
  conceptAttempts                 ConceptAssessmentAttempt[]
  quizAttempts                    QuizAttempt[]
  exerciseSubmissions             ExerciseSubmission[]
  stageAssessmentSubmissions      StageAssessmentSubmission[]
  aiCorrections                   AiCorrection[]
  creditAccounts                  CreditAccount[]               @relation("CreditAccountOwner")
  creditAdjustmentEntries         CreditLedgerEntry[]           @relation("CreditLedgerAdjustmentActor")
  creditGrantCycles               CreditGrantCycle[]
  creditIncreaseRequests          CreditIncreaseRequest[]       @relation("CreditIncreaseRequestOwner")
  reviewedCreditIncreaseRequests  CreditIncreaseRequest[]       @relation("CreditIncreaseRequestReviewer")
  aiPricingQuotes                 AiPricingQuote[]
  reviewItems                     ReviewItem[]
  notes                           Note[]
  moduleRuns                      ModuleRun[]
  activityCompletionCarryovers    ActivityCompletionCarryover[]
  reviewedAccessRequests          AccessRequest[]               @relation("AccessRequestReviewer")
  activatedAccessRequest          AccessRequest?                @relation("ActivatedAccessRequest")
  issuedAccessInvitations         AccessInvitation[]            @relation("AccessInvitationIssuer")
  auditEvents                     AuditEvent[]                  @relation("AuditEventActor")
  publishedProgramVersions        ProgramVersion[]              @relation("ProgramVersionPublisher")
  programEnrollments              ProgramEnrollment[]
  programViewPreferences          ProgramViewPreference[]
  linguisticTranslationReviews    ProgramTranslationWorkflow[]  @relation("TranslationLinguisticReviewer")
  pedagogicalTranslationReviews   ProgramTranslationWorkflow[]  @relation("TranslationPedagogicalReviewer")
  culturalLegalTranslationReviews ProgramTranslationWorkflow[]  @relation("TranslationCulturalLegalReviewer")
  approvedTranslationWorkflows    ProgramTranslationWorkflow[]  @relation("TranslationWorkflowApprover")

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginRateLimit {
  keyHash         String   @id @map("key_hash")
  failures        Int
  windowStartedAt DateTime @map("window_started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([windowStartedAt])
  @@map("login_rate_limits")
}

model AccessRequest {
  id                 String              @id @default(uuid()) @db.Uuid
  emailNormalized    String              @map("email_normalized")
  status             AccessRequestStatus @default(PENDING_EMAIL)
  locale             String              @default("fr") @db.VarChar(2)
  version            Int                 @default(1)
  emailVerifiedAt    DateTime?           @map("email_verified_at")
  reviewedAt         DateTime?           @map("reviewed_at")
  reviewedByUserId   String?             @map("reviewed_by_user_id") @db.Uuid
  rejectionReason    String?             @map("rejection_reason")
  activatedUserId    String?             @unique @map("activated_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  reviewedBy         User?               @relation("AccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  activatedUser      User?               @relation("ActivatedAccessRequest", fields: [activatedUserId], references: [id], onDelete: SetNull)
  emailVerifications EmailVerification[]
  invitations        AccessInvitation[]
  sourcePublicLead   PublicLead?

  @@index([emailNormalized, status])
  @@index([status, createdAt])
  @@map("access_requests")
}

model PublicLead {
  id                       String            @id @default(uuid()) @db.Uuid
  contactId                String            @map("contact_id") @db.Uuid
  purpose                  PublicLeadPurpose
  status                   PublicLeadStatus  @default(PENDING_CONFIRMATION)
  locale                   String            @default("fr") @db.VarChar(2)
  motivation               String?
  consentVersion           String            @map("consent_version") @db.VarChar(32)
  confirmationTokenHash    String?           @unique @map("confirmation_token_hash")
  confirmationExpiresAt    DateTime?         @map("confirmation_expires_at")
  managementTokenHash      String?           @unique @map("management_token_hash")
  confirmedAt              DateTime?         @map("confirmed_at")
  unsubscribedAt           DateTime?         @map("unsubscribed_at")
  deletedAt                DateTime?         @map("deleted_at")
  convertedAccessRequestId String?           @unique @map("converted_access_request_id") @db.Uuid
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  convertedAccessRequest   AccessRequest?    @relation(fields: [convertedAccessRequestId], references: [id], onDelete: SetNull)
  contact                  PublicContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, purpose])
  @@index([purpose, status, createdAt])
  @@map("public_leads")
}

model PublicContact {
  id              String       @id @default(uuid()) @db.Uuid
  emailNormalized String       @unique @map("email_normalized")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  leads           PublicLead[]

  @@map("public_contacts")
}

model EmailVerification {
  id              String        @id @default(uuid()) @db.Uuid
  accessRequestId String        @map("access_request_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  expiresAt       DateTime      @map("expires_at")
  consumedAt      DateTime?     @map("consumed_at")
  invalidatedAt   DateTime?     @map("invalidated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@index([accessRequestId, expiresAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model AccessInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  accessRequestId String        @map("access_request_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  assignedRole    Role          @default(USER) @map("assigned_role")
  expiresAt       DateTime      @map("expires_at")
  consumedAt      DateTime?     @map("consumed_at")
  invalidatedAt   DateTime?     @map("invalidated_at")
  invitedByUserId String?       @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  invitedBy       User?         @relation("AccessInvitationIssuer", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([accessRequestId, expiresAt])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@map("access_invitations")
}

model AuditEvent {
  id             String      @id @default(uuid()) @db.Uuid
  actorUserId    String      @map("actor_user_id") @db.Uuid
  action         AuditAction
  targetType     String      @map("target_type")
  targetId       String      @map("target_id") @db.Uuid
  idempotencyKey String      @map("idempotency_key")
  metadata       Json        @default("{}") @map("metadata_json")
  createdAt      DateTime    @default(now()) @map("created_at")
  actor          User        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, action, idempotencyKey])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model Program {
  id                    String                      @id @default(uuid()) @db.Uuid
  ownerId               String                      @map("owner_id") @db.Uuid
  title                 String
  slug                  String
  canonicalProgramKey   String                      @map("canonical_program_key")
  locale                String                      @default("fr") @db.VarChar(2)
  description           String
  status                ProgramStatus               @default(DRAFT)
  visibility            ProgramVisibility           @default(PRIVATE)
  icon                  String?
  position              Int                         @default(0)
  estimatedDurationDays Int?                        @map("estimated_duration_days")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  publishedVersionId    String?                     @unique @map("published_version_id") @db.Uuid
  owner                 User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  publishedVersion      ProgramVersion?             @relation("CurrentPublishedProgramVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions              ProgramVersion[]            @relation("ProgramVersions")
  enrollments           ProgramEnrollment[]
  viewPreferences       ProgramViewPreference[]
  stages                Stage[]
  progress              ProgramProgress[]
  reviewItems           ReviewItem[]
  notes                 Note[]
  translationWorkflow   ProgramTranslationWorkflow?

  @@unique([ownerId, slug])
  @@unique([ownerId, canonicalProgramKey, locale])
  @@index([ownerId, position])
  @@index([locale, visibility, status, position])
  @@index([visibility, status, position])
  @@map("programs")
}

model ProgramTranslationWorkflow {
  id                      String                    @id @default(uuid()) @db.Uuid
  programId               String                    @unique @map("program_id") @db.Uuid
  sourceProgramVersionId  String                    @map("source_program_version_id") @db.Uuid
  status                  TranslationWorkflowStatus @default(DRAFT)
  glossaryVersion         String                    @map("glossary_version")
  qaChecks                Json                      @default("{}") @map("qa_checks_json")
  linguisticReviewerId    String?                   @map("linguistic_reviewer_id") @db.Uuid
  linguisticReviewedAt    DateTime?                 @map("linguistic_reviewed_at")
  pedagogicalReviewerId   String?                   @map("pedagogical_reviewer_id") @db.Uuid
  pedagogicalReviewedAt   DateTime?                 @map("pedagogical_reviewed_at")
  culturalLegalReviewerId String?                   @map("cultural_legal_reviewer_id") @db.Uuid
  culturalLegalReviewedAt DateTime?                 @map("cultural_legal_reviewed_at")
  approvedByUserId        String?                   @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime?                 @map("approved_at")
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  program                 Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  sourceProgramVersion    ProgramVersion            @relation("TranslationSourceProgramVersion", fields: [sourceProgramVersionId], references: [id], onDelete: Restrict)
  linguisticReviewer      User?                     @relation("TranslationLinguisticReviewer", fields: [linguisticReviewerId], references: [id], onDelete: Restrict)
  pedagogicalReviewer     User?                     @relation("TranslationPedagogicalReviewer", fields: [pedagogicalReviewerId], references: [id], onDelete: Restrict)
  culturalLegalReviewer   User?                     @relation("TranslationCulturalLegalReviewer", fields: [culturalLegalReviewerId], references: [id], onDelete: Restrict)
  approvedBy              User?                     @relation("TranslationWorkflowApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([sourceProgramVersionId])
  @@index([status, updatedAt])
  @@map("program_translation_workflows")
}

model ProgramVersion {
  id                  String                       @id @default(uuid()) @db.Uuid
  programId           String                       @map("program_id") @db.Uuid
  version             Int
  checksum            String
  snapshot            Json                         @map("snapshot_json")
  publishedAt         DateTime                     @default(now()) @map("published_at")
  publishedByUserId   String                       @map("published_by_user_id") @db.Uuid
  program             Program                      @relation("ProgramVersions", fields: [programId], references: [id], onDelete: Cascade)
  publishedBy         User                         @relation("ProgramVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  currentForProgram   Program?                     @relation("CurrentPublishedProgramVersion")
  enrollments         ProgramEnrollment[]
  derivedTranslations ProgramTranslationWorkflow[] @relation("TranslationSourceProgramVersion")

  @@unique([programId, version])
  @@unique([programId, checksum])
  @@unique([programId, id])
  @@index([programId, publishedAt])
  @@index([publishedByUserId, publishedAt])
  @@map("program_versions")
}

model ProgramEnrollment {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  programId        String                  @map("program_id") @db.Uuid
  programVersionId String                  @map("program_version_id") @db.Uuid
  status           ProgramEnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime                @default(now()) @map("enrolled_at")
  withdrawnAt      DateTime?               @map("withdrawn_at")

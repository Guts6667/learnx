generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_role")
}

enum ProgramStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("program_status")
}

enum ContentBlockType {
  RICH_TEXT  @map("rich_text")
  OBJECTIVE  @map("objective")
  DEFINITION @map("definition")
  EXAMPLE    @map("example")
  CALLOUT    @map("callout")
  QUOTE      @map("quote")
  EMBED      @map("embed")
  DIVIDER    @map("divider")

  @@map("content_block_type")
}

enum ResourceType {
  BOOK         @map("book")
  BOOK_CHAPTER @map("book_chapter")
  ARTICLE      @map("article")
  VIDEO        @map("video")
  COURSE       @map("course")
  PODCAST      @map("podcast")
  WEBSITE      @map("website")
  DOCUMENT     @map("document")
  TOOL         @map("tool")

  @@map("resource_type")
}

enum TaskType {
  READING    @map("reading")
  WATCHING   @map("watching")
  LISTENING  @map("listening")
  REFLECTION @map("reflection")
  CHECKLIST  @map("checklist")
  WRITING    @map("writing")
  PRACTICE   @map("practice")
  PROJECT    @map("project")

  @@map("task_type")
}

enum CanonicalActivityKind {
  TASK     @map("task")
  EXERCISE @map("exercise")

  @@map("canonical_activity_kind")
}

enum LessonProgressStatus {
  AVAILABLE    @map("available")
  IN_PROGRESS  @map("in_progress")
  COMPLETED    @map("completed")
  NEEDS_REVIEW @map("needs_review")

  @@map("lesson_progress_status")
}

enum TaskCompletionStatus {
  TODO    @map("todo")
  DONE    @map("done")
  SKIPPED @map("skipped")

  @@map("task_completion_status")
}

enum ResourceProgressStatus {
  NOT_STARTED @map("not_started")
  STARTED     @map("started")
  COMPLETED   @map("completed")

  @@map("resource_progress_status")
}

enum StageProgressStatus {
  LOCKED      @map("locked")
  AVAILABLE   @map("available")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")

  @@map("stage_progress_status")
}

enum StageAssessmentType {
  PROJECT            @map("project")
  CASE_STUDY         @map("case_study")
  WRITTEN_ASSIGNMENT @map("written_assignment")
  PRACTICAL_EXERCISE @map("practical_exercise")
  ORAL               @map("oral")
  SIMULATION         @map("simulation")
  CUMULATIVE_EXAM    @map("cumulative_exam")

  @@map("stage_assessment_type")
}

enum StageAssessmentSubmissionStatus {
  DRAFT          @map("draft")
  SUBMITTED      @map("submitted")
  VALIDATED      @map("validated")
  NEEDS_REVISION @map("needs_revision")

  @@map("stage_assessment_submission_status")
}

enum ConceptAssessmentType {
  QUIZ          @map("quiz")
  SHORT_ANSWER  @map("short_answer")
  PRACTICE      @map("practice")
  FLASHCARD     @map("flashcard")
  CASE_QUESTION @map("case_question")

  @@map("concept_assessment_type")
}

enum ConceptProgressStatus {
  NOT_STARTED  @map("not_started")
  LEARNING     @map("learning")
  VALIDATED    @map("validated")
  NEEDS_REVIEW @map("needs_review")

  @@map("concept_progress_status")
}

enum ConceptQuestionType {
  TRUE_FALSE      @map("true_false")
  SINGLE_CHOICE   @map("single_choice")
  MULTIPLE_CHOICE @map("multiple_choice")
  SHORT_ANSWER    @map("short_answer")

  @@map("concept_question_type")
}

enum QuizQuestionType {
  TRUE_FALSE      @map("true_false")
  SINGLE_CHOICE   @map("single_choice")
  MULTIPLE_CHOICE @map("multiple_choice")
  SHORT_ANSWER    @map("short_answer")

  @@map("quiz_question_type")
}

enum ExerciseSubmissionStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")

  @@map("exercise_submission_status")
}

enum ReviewSourceType {
  CONCEPT_ASSESSMENT @map("concept_assessment")

  @@map("review_source_type")
}

enum ReviewStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")

  @@map("review_status")
}

model User {
  id                           String                        @id @default(uuid()) @db.Uuid
  email                        String                        @unique
  passwordHash                 String                        @map("password_hash")
  displayName                  String                        @map("display_name")
  role                         Role                          @default(USER)
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  sessions                     Session[]
  programs                     Program[]
  programProgresses            ProgramProgress[]
  stageProgresses              StageProgress[]
  lessonProgresses             LessonProgress[]
  taskCompletions              TaskCompletion[]
  resourceProgresses           ResourceProgress[]
  conceptProgresses            ConceptProgress[]
  conceptAttempts              ConceptAssessmentAttempt[]
  quizAttempts                 QuizAttempt[]
  exerciseSubmissions          ExerciseSubmission[]
  stageAssessmentSubmissions   StageAssessmentSubmission[]
  reviewItems                  ReviewItem[]
  notes                        Note[]
  moduleRuns                   ModuleRun[]
  activityCompletionCarryovers ActivityCompletionCarryover[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model LoginRateLimit {
  keyHash         String   @id @map("key_hash")
  failures        Int
  windowStartedAt DateTime @map("window_started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([windowStartedAt])
  @@map("login_rate_limits")
}

model Program {
  id                    String            @id @default(uuid()) @db.Uuid
  ownerId               String            @map("owner_id") @db.Uuid
  title                 String
  slug                  String
  description           String
  status                ProgramStatus     @default(DRAFT)
  icon                  String?
  position              Int               @default(0)
  estimatedDurationDays Int?              @map("estimated_duration_days")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stages                Stage[]
  progress              ProgramProgress[]
  reviewItems           ReviewItem[]
  notes                 Note[]

  @@unique([ownerId, slug])
  @@index([ownerId, position])
  @@map("programs")
}

model Stage {
  id                    String            @id @default(uuid()) @db.Uuid
  programId             String            @map("program_id") @db.Uuid
  title                 String
  slug                  String
  description           String
  position              Int               @default(0)
  estimatedMinutes      Int?              @map("estimated_minutes")
  estimatedDurationDays Int?              @map("estimated_duration_days")
  isPublished           Boolean           @default(false) @map("is_published")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  program               Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  modules               Module[]
  progress              StageProgress[]
  assessments           StageAssessment[]

  @@unique([programId, slug])
  @@index([programId, position])
  @@map("stages")
}

model StageAssessment {
  id           String                      @id @default(uuid()) @db.Uuid
  stageId      String                      @map("stage_id") @db.Uuid
  title        String
  description  String?
  type         StageAssessmentType
  instructions String?
  rubric       Json?                       @map("rubric_json")
  passingScore Float?                      @map("passing_score")
  isRequired   Boolean                     @default(true) @map("is_required")
  position     Int                         @default(0)
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  stage        Stage                       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  submissions  StageAssessmentSubmission[]

  @@unique([stageId, position])
  @@index([stageId, position])
  @@map("stage_assessments")
}

model StageAssessmentSubmission {
  id                String                          @id @default(uuid()) @db.Uuid
  userId            String                          @map("user_id") @db.Uuid
  stageAssessmentId String                          @map("stage_assessment_id") @db.Uuid
  contentMarkdown   String?                         @map("content_markdown")
  attachmentUrl     String?                         @map("attachment_url")
  score             Float?
  reviewFeedback    String?                         @map("review_feedback")
  status            StageAssessmentSubmissionStatus @default(DRAFT)
  submittedAt       DateTime?                       @map("submitted_at")
  reviewedAt        DateTime?                       @map("reviewed_at")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageAssessment   StageAssessment                 @relation(fields: [stageAssessmentId], references: [id], onDelete: Cascade)

  @@unique([userId, stageAssessmentId])
  @@index([stageAssessmentId, status])
  @@map("stage_assessment_submissions")
}

model Module {
  id               String      @id @default(uuid()) @db.Uuid
  stageId          String      @map("stage_id") @db.Uuid
  title            String
  slug             String
  description      String
  position         Int         @default(0)
  estimatedMinutes Int?        @map("estimated_minutes")
  isPublished      Boolean     @default(false) @map("is_published")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  stage            Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  runs             ModuleRun[]

  @@unique([stageId, slug])
  @@index([stageId, position])
  @@map("modules")
}

model ModuleRun {
  id                           String                        @id @default(uuid()) @db.Uuid
  userId                       String                        @map("user_id") @db.Uuid
  moduleId                     String                        @map("module_id") @db.Uuid
  sequence                     Int
  startedAt                    DateTime                      @default(now()) @map("started_at")
  restartKey                   String?                       @map("restart_key") @db.Uuid
  createdAt                    DateTime                      @default(now()) @map("created_at")
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module                       Module                        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizAttempts                 QuizAttempt[]
  conceptAttempts              ConceptAssessmentAttempt[]
  exerciseSubmissions          ExerciseSubmission[]
  activityCompletionCarryovers ActivityCompletionCarryover[]

  @@unique([userId, moduleId, sequence])
  @@unique([userId, moduleId, restartKey])
  @@index([userId, moduleId, startedAt])
  @@map("module_runs")
}

model Lesson {
  id                           String                        @id @default(uuid()) @db.Uuid
  moduleId                     String                        @map("module_id") @db.Uuid
  title                        String
  slug                         String
  summary                      String
  objectives                   Json                          @map("objectives_json")
  prerequisites                Json                          @map("prerequisites_json")
  estimatedMinutes             Int?                          @map("estimated_minutes")
  position                     Int                           @default(0)
  isPublished                  Boolean                       @default(false) @map("is_published")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  module                       Module                        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  contentBlocks                ContentBlock[]
  resources                    Resource[]
  tasks                        Task[]
  progress                     LessonProgress[]
  concepts                     Concept[]
  quizzes                      Quiz[]
  exercises                    Exercise[]
  reviewItems                  ReviewItem[]
  notes                        Note[]
  activityCompletionCarryovers ActivityCompletionCarryover[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

model ContentBlock {
  id       String           @id @default(uuid()) @db.Uuid
  lessonId String           @map("lesson_id") @db.Uuid
  type     ContentBlockType
  content  Json             @map("content_json")
  position Int              @default(0)
  lesson   Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId, position])
  @@map("content_blocks")
}

model Resource {
  id               String             @id @default(uuid()) @db.Uuid
  lessonId         String             @map("lesson_id") @db.Uuid
  key              String?
  type             ResourceType
  title            String
  author           String?
  url              String?
  citation         String?
  description      String?
  isRequired       Boolean            @default(false) @map("is_required")
  estimatedMinutes Int?               @map("estimated_minutes")
  position         Int                @default(0)
  lesson           Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress         ResourceProgress[]
  conceptLinks     ConceptResource[]
  taskLinks        TaskResource[]

  @@unique([lessonId, key])
  @@index([lessonId, position])
  @@map("resources")
}

model Task {
  id          String           @id @default(uuid()) @db.Uuid
  lessonId    String           @map("lesson_id") @db.Uuid
  key         String
  title       String
  description String?
  type        TaskType
  isRequired  Boolean          @default(true) @map("is_required")
  weight      Float            @default(1)
  position    Int              @default(0)
  isCanonical Boolean          @default(true) @map("is_canonical")
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completions TaskCompletion[]
  resources   TaskResource[]

  @@unique([lessonId, position])
  @@unique([lessonId, key])
  @@index([lessonId, position])
  @@map("tasks")
}

model LessonProgress {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  lessonId     String               @map("lesson_id") @db.Uuid
  status       LessonProgressStatus @default(AVAILABLE)
  percent      Float                @default(0)
  startedAt    DateTime?            @map("started_at")
  completedAt  DateTime?            @map("completed_at")
  lastViewedAt DateTime?            @map("last_viewed_at")
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@map("lesson_progress")
}

model ProgramProgress {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  programId    String    @map("program_id") @db.Uuid
  percent      Float     @default(0)
  startedAt    DateTime? @map("started_at")
  targetEndAt  DateTime? @map("target_end_at")
  completedAt  DateTime? @map("completed_at")
  lastViewedAt DateTime  @default(now()) @map("last_viewed_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId, lastViewedAt])
  @@map("program_progress")
}

model StageProgress {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  stageId      String              @map("stage_id") @db.Uuid
  status       StageProgressStatus @default(AVAILABLE)
  percent      Float               @default(0)
  startedAt    DateTime?           @map("started_at")
  targetEndAt  DateTime?           @map("target_end_at")
  completedAt  DateTime?           @map("completed_at")
  lastViewedAt DateTime?           @map("last_viewed_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage        Stage               @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
  @@index([userId, status])
  @@map("stage_progress")
}

model TaskCompletion {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  taskId      String               @map("task_id") @db.Uuid
  status      TaskCompletionStatus @default(TODO)
  completedAt DateTime?            @map("completed_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, status])
  @@map("task_completions")
}

model ResourceProgress {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  resourceId  String                 @map("resource_id") @db.Uuid
  status      ResourceProgressStatus @default(NOT_STARTED)
  completedAt DateTime?              @map("completed_at")
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource    Resource               @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, status])
  @@map("resource_progress")
}

model Quiz {
  id           String        @id @default(uuid()) @db.Uuid
  lessonId     String        @map("lesson_id") @db.Uuid
  title        String
  description  String?
  passingScore Float         @default(70) @map("passing_score")
  isRequired   Boolean       @default(true) @map("is_required")
  position     Int           @default(0)
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     QuizAttempt[]

  @@unique([lessonId, position])
  @@index([lessonId, position])
  @@map("quizzes")
}

model Question {
  id              String           @id @default(uuid()) @db.Uuid
  quizId          String           @map("quiz_id") @db.Uuid
  type            QuizQuestionType
  prompt          String
  explanation     String
  acceptedAnswers String[]         @default([]) @map("accepted_answers")
  position        Int              @default(0)
  quiz            Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options         QuestionOption[]

  @@unique([quizId, position])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("question_options")
}

model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  quizId      String    @map("quiz_id") @db.Uuid
  moduleRunId String    @map("module_run_id") @db.Uuid
  score       Float
  passed      Boolean
  answers     Json      @map("answers_json")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  moduleRun   ModuleRun @relation(fields: [moduleRunId], references: [id], onDelete: Cascade)

  @@index([userId, quizId, moduleRunId, submittedAt], map: "quiz_attempts_user_quiz_run_submitted_idx")
  @@map("quiz_attempts")
}

model Exercise {
  id           String               @id @default(uuid()) @db.Uuid
  lessonId     String               @map("lesson_id") @db.Uuid
  key          String
  activityType TaskType             @map("activity_type")
  title        String
  instructions String
  rubric       Json?                @map("rubric_json")
  isRequired   Boolean              @default(true) @map("is_required")
  position     Int                  @default(0)
  isCanonical  Boolean              @default(true) @map("is_canonical")
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  ExerciseSubmission[]

  @@unique([lessonId, position])
  @@unique([lessonId, key])
  @@index([lessonId, position])
  @@map("exercises")
}

model TaskResource {
  taskId     String   @map("task_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([taskId, resourceId])
  @@index([resourceId])
  @@map("task_resources")
}

model ActivityCompletionCarryover {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  lessonId    String                @map("lesson_id") @db.Uuid
  activityKey String                @map("activity_key")
  kind        CanonicalActivityKind
  moduleRunId String                @map("module_run_id") @db.Uuid
  completedAt DateTime              @map("completed_at")
  sources     Json                  @map("sources_json")
  createdAt   DateTime              @default(now()) @map("created_at")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  moduleRun   ModuleRun             @relation(fields: [moduleRunId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, activityKey, kind, moduleRunId])
  @@index([lessonId, activityKey, kind])
  @@map("activity_completion_carryovers")
}

model ExerciseSubmission {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  exerciseId      String                   @map("exercise_id") @db.Uuid
  moduleRunId     String                   @map("module_run_id") @db.Uuid
  contentMarkdown String                   @default("") @map("content_markdown")
  status          ExerciseSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?                @map("submitted_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise        Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  moduleRun       ModuleRun                @relation(fields: [moduleRunId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, moduleRunId])
  @@index([exerciseId, status])
  @@map("exercise_submissions")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  lessonId  String?  @map("lesson_id") @db.Uuid
  title     String
  markdown  String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, lessonId])
  @@map("notes")
}

model Concept {
  id               String              @id @default(uuid()) @db.Uuid
  lessonId         String              @map("lesson_id") @db.Uuid
  title            String
  slug             String
  description      String?
  position         Int                 @default(0)
  isRequired       Boolean             @default(true) @map("is_required")
  masteryThreshold Float               @default(70) @map("mastery_threshold")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  lesson           Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  resources        ConceptResource[]
  assessments      ConceptAssessment[]
  progress         ConceptProgress[]

  @@unique([lessonId, slug])
  @@index([lessonId, position])
  @@map("concepts")
}

model ConceptResource {
  id         String   @id @default(uuid()) @db.Uuid
  conceptId  String   @map("concept_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([conceptId, resourceId])
  @@index([resourceId])
  @@map("concept_resources")
}

model ConceptAssessment {
  id             String                      @id @default(uuid()) @db.Uuid
  conceptId      String                      @map("concept_id") @db.Uuid
  assessmentType ConceptAssessmentType       @map("assessment_type")
  title          String?
  questionCount  Int?                        @map("question_count")
  isRequired     Boolean                     @default(true) @map("is_required")
  position       Int                         @default(0)
  concept        Concept                     @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  questions      ConceptAssessmentQuestion[]
  attempts       ConceptAssessmentAttempt[]

  @@index([conceptId, position])
  @@map("concept_assessments")
}

model ConceptAssessmentQuestion {
  id              String                    @id @default(uuid()) @db.Uuid
  assessmentId    String                    @map("assessment_id") @db.Uuid
  type            ConceptQuestionType
  prompt          String
  explanation     String
  acceptedAnswers String[]                  @default([]) @map("accepted_answers")
  position        Int                       @default(0)
  assessment      ConceptAssessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options         ConceptAssessmentOption[]

  @@unique([assessmentId, position])
  @@map("concept_assessment_questions")
}

model ConceptAssessmentOption {
  id         String                    @id @default(uuid()) @db.Uuid
  questionId String                    @map("question_id") @db.Uuid
  label      String
  isCorrect  Boolean                   @default(false) @map("is_correct")
  position   Int                       @default(0)
  question   ConceptAssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("concept_assessment_options")
}

model ConceptAssessmentAttempt {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  assessmentId String            @map("assessment_id") @db.Uuid
  moduleRunId  String            @map("module_run_id") @db.Uuid
  answers      Json              @map("answers_json")
  score        Float
  passed       Boolean
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   ConceptAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  moduleRun    ModuleRun         @relation(fields: [moduleRunId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId, moduleRunId, submittedAt], map: "concept_assessment_attempts_user_assessment_run_submitted_idx")
  @@map("concept_assessment_attempts")
}

model ConceptProgress {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  conceptId     String                @map("concept_id") @db.Uuid
  status        ConceptProgressStatus @default(NOT_STARTED)
  bestScore     Float?                @map("best_score")
  validatedAt   DateTime?             @map("validated_at")
  lastAttemptAt DateTime?             @map("last_attempt_at")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept       Concept               @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, status])
  @@map("concept_progress")
}

model ReviewItem {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  programId    String           @map("program_id") @db.Uuid
  lessonId     String           @map("lesson_id") @db.Uuid
  sourceType   ReviewSourceType @map("source_type")
  sourceId     String           @map("source_id") @db.Uuid
  dueAt        DateTime         @map("due_at")
  intervalDays Int              @default(1) @map("interval_days")
  status       ReviewStatus     @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  completedAt  DateTime?        @map("completed_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, dueAt, status])
  @@map("review_items")
}

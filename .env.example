# URL poolée Neon utilisée par les Vercel Functions.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# URL directe Neon utilisée exclusivement par Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Origine publique de l'application, sans slash final.
APP_URL="http://localhost:5173"

# Compte propriétaire existant auquel le seed rattache le programme exemple.
ADMIN_EMAIL="owner@example.com"

# Demandes d'accès publiques. En production, l'activation doit être explicite
# et la vérification e-mail entièrement configurée ; sinon l'API répond 503 sans
# créer de demande. Les limites s'appliquent par fenêtre.
LEARNX_ACCESS_REQUESTS_ENABLED="false"
LEARNX_ACCESS_REQUEST_RATE_LIMIT_MAX_EMAIL="5"
LEARNX_ACCESS_REQUEST_RATE_LIMIT_MAX_IP="20"
LEARNX_ACCESS_REQUEST_RATE_LIMIT_WINDOW_MS="900000"

# Vérification des e-mails de demande d'accès via Resend. L'envoi reste inactif
# tant que le flag n'est pas explicitement activé. La clé ne doit jamais être
# exposée au frontend ni commitée.
LEARNX_EMAIL_VERIFICATION_ENABLED="false"
LEARNX_EMAIL_VERIFICATION_TTL_MS="86400000"
# Durée de validité des invitations d’activation (5 minutes à 7 jours).
LEARNX_ACCESS_INVITATION_TTL_MS="604800000"
LEARNX_EMAIL_FROM="LearnX <access@example.com>"
RESEND_API_KEY=""

# Landing publique : collecte distincte des comptes et demandes d'accès.
# Nécessite APP_URL, LEARNX_EMAIL_FROM et RESEND_API_KEY.
LEARNX_PUBLIC_LEADS_ENABLED="false"

# Politique de rétention des seules données techniques expirées. Le script
# `pnpm maintenance:cleanup` reste en simulation tant que `--apply` est absent.
LEARNX_RETENTION_SESSION_GRACE_MS="604800000"
LEARNX_RETENTION_RATE_LIMIT_MS="86400000"
LEARNX_RETENTION_TOKEN_MS="2592000000"
# Deux ans pour les contacts non confirmés, désinscrits ou anonymisés.
LEARNX_RETENTION_PUBLIC_LEAD_MS="63072000000"
LEARNX_RETENTION_BATCH_SIZE="500"
LEARNX_RETENTION_MAX_BATCHES="20"

# Garde-fous réservés aux tests d’intégration sur une branche Neon jetable.
# Ne jamais les activer avec la base de développement ou de production.
LEARNX_INTEGRATION_DATABASE=""
LEARNX_INTEGRATION_RUN_ID=""
NEON_BRANCH_ID=""

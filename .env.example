# URL poolée Neon utilisée par les Vercel Functions.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# URL directe Neon utilisée exclusivement par Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Origine publique de l'application, sans slash final.
APP_URL="http://localhost:5173"

# Compte propriétaire existant auquel le seed rattache le programme exemple.
ADMIN_EMAIL="owner@example.com"

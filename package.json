{
  "name": "learnx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "pnpm prisma:generate && pnpm prisma:deploy && pnpm build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage:baseline": "NODE_OPTIONS=--no-experimental-webstorage LEARNX_V4_1_QUALITY_MODE=baseline vitest run --coverage",
    "test:coverage:v4.1": "NODE_OPTIONS=--no-experimental-webstorage LEARNX_V4_1_QUALITY_MODE=final vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:research": "playwright test tests/e2e/research-journal.spec.ts --project=desktop-chromium",
    "test:integration": "node --import tsx scripts/run-integration-tests.ts",
    "integration:serve": "node --import tsx scripts/integration-server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:check": "tsx scripts/check-database.ts",
    "prisma:validate-sequence": "tsx scripts/validate-lesson-sequence-backfill.ts",
    "prisma:validate-sequence-removal": "tsx scripts/validate-lesson-sequence-seed-removal.ts",
    "sourcelab:replacement:plan": "tsx scripts/plan-sourcelab-v2-replacement.ts",
    "progress:recalculate": "tsx scripts/recalculate-progress.ts",
    "maintenance:cleanup": "tsx scripts/cleanup-expired-data.ts",
    "performance:measure": "tsx scripts/measure-database-performance.ts",
    "migration:rehearse": "tsx scripts/migration-rehearsal.ts",
    "deployment:check": "tsx scripts/check-deployment.ts",
    "ai:release:check": "tsx scripts/check-ai-release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n-catalogs.ts",
    "icons:export": "tsx scripts/export-atlas-icons.ts",
    "editorial:bilingual:check": "tsx scripts/validate-bilingual-editorial.ts",
    "ai:benchmark:validate": "tsx scripts/run-ai-correction-benchmark.ts --validate-only",
    "ai:benchmark": "tsx scripts/run-ai-correction-benchmark.ts",
    "quality:bundle": "tsx scripts/check-v4-1-bundle.ts",
    "quality:coverage:critical:report": "tsx scripts/check-v4-1-critical-coverage.ts",
    "quality:coverage:critical": "tsx scripts/check-v4-1-critical-coverage.ts --final",
    "quality:dead-code": "knip",
    "quality:dead-css": "tsx scripts/check-dead-css.ts",
    "quality:imports:baseline": "pnpm typecheck && tsx scripts/check-v4-1-imports.ts --mode baseline",
    "quality:imports:v4.1": "pnpm typecheck && tsx scripts/check-v4-1-imports.ts --mode final",
    "quality:airtable": "tsx scripts/check-v4-1-airtable.ts",
    "quality:prepare": "pnpm prisma:generate",
    "quality:security": "pnpm audit --audit-level=high --prod",
    "quality:v4.1:baseline": "pnpm quality:prepare && pnpm i18n:check && pnpm format:check && pnpm lint && pnpm quality:imports:baseline && pnpm test:coverage:baseline && pnpm quality:coverage:critical:report && pnpm build && pnpm quality:bundle && pnpm quality:security",
    "quality:v4.1:final": "pnpm quality:prepare && pnpm i18n:check && pnpm format:check && pnpm lint && pnpm quality:imports:v4.1 && pnpm test:coverage:v4.1 && pnpm quality:coverage:critical && pnpm quality:dead-code && pnpm quality:dead-css && pnpm build && pnpm quality:bundle && pnpm quality:security"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.101.4",
    "argon2": "^0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}

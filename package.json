{
  "name": "learnx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "pnpm prisma:generate && pnpm prisma:deploy && pnpm build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "node --import tsx scripts/run-integration-tests.ts",
    "integration:serve": "node --import tsx scripts/integration-server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:check": "tsx scripts/check-database.ts",
    "prisma:validate-sequence": "tsx scripts/validate-lesson-sequence-backfill.ts",
    "prisma:validate-sequence-removal": "tsx scripts/validate-lesson-sequence-seed-removal.ts",
    "progress:recalculate": "tsx scripts/recalculate-progress.ts",
    "maintenance:cleanup": "tsx scripts/cleanup-expired-data.ts",
    "performance:measure": "tsx scripts/measure-database-performance.ts",
    "deployment:check": "tsx scripts/check-deployment.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n-catalogs.ts",
    "editorial:bilingual:check": "tsx scripts/validate-bilingual-editorial.ts"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/query-core": "^5.101.4",
    "argon2": "^0.45.1",
    "hono": "^4.13.0",
    "preact": "^10.29.8",
    "preact-router": "^4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.18"
    }
  }
}

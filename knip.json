{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "api/**/*.ts",
    "playwright.integration.config.ts",
    "scripts/**/*.{ts,mjs}",
    "src/lib/utils.ts"
  ],
  "ignoreDependencies": [
    "@fontsource/dm-sans",
    "@fontsource/plus-jakarta-sans",
    "@prisma/client"
  ],
  "project": [
    "api/**/*.ts",
    "prisma/**/*.prisma",
    "prisma/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "src/**/*.{css,ts,tsx}",
    "tests/**/*.ts",
    "*.{ts,mjs}"
  ]
}
